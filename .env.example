# MongoDB Atlas Connection String
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority"

# JWT Secret for signing session authentication tokens
JWT_SECRET="imovies-super-secret-jwt-key-change-in-production-2026"

# Server Port (defaults to 3000 in AI Studio / Cloud Run)
PORT=3000

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
